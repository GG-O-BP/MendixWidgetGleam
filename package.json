{
  "name": "mendixwidgetgleam",
  "widgetName": "MendixWidget",
  "version": "5.0.0",
  "description": "Reference Mendix Pluggable Widget built with Gleam, Glendix, Mendraw, and Lustre",
  "copyright": "© 2026 Glendix Labs contributors.",
  "author": "Glendix Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glendix-labs/MendixWidgetGleam.git"
  },
  "bugs": {
    "url": "https://github.com/glendix-labs/MendixWidgetGleam/issues"
  },
  "homepage": "https://github.com/glendix-labs/MendixWidgetGleam#readme",
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=25.0.0"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "config": {
    "projectPath": "./tests/testProject",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "mendix",
  "scripts": {
    "build": "gleam run -m glendix/build --runtime bun",
    "check": "gleam check",
    "dev": "gleam run -m glendix/dev --runtime bun",
    "test": "gleam test --runtime bun"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "^11.12.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "core-js": true,
    "unrs-resolver": true
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "core-js",
    "unrs-resolver"
  ]
}
