{
  "name": "{{LOWERCASE}}",
  "widgetName": "{{PASCAL_CASE}}",
  "version": "{{VERSION}}",
  "description": "My widget description",
  "copyright": {{COPYRIGHT_JSON}},
  "author": {{AUTHOR_JSON}},
{{PACKAGE_MANAGER_FIELD}}  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=25.0.0"
  },
  "license": "MIT",
  "config": {
    "projectPath": {{PROJECT_PATH_JSON}},
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "{{ORGANIZATION}}",
  "scripts": {
    "build": "gleam run -m glendix/build --runtime {{JAVASCRIPT_RUNTIME}}",
    "check": "gleam check",
    "dev": "gleam run -m glendix/dev --runtime {{JAVASCRIPT_RUNTIME}}",
    "test": "gleam test --runtime {{JAVASCRIPT_RUNTIME}}"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "^11.12.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": true
    },
    "@swc/core": {
      "built": true
    },
    "core-js": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "core-js": true,
    "unrs-resolver": true
  },
