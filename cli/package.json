{
  "name": "create-mendix-widget-gleam",
  "version": "5.0.0",
  "description": "Scaffold a Mendix Pluggable Widget powered by Gleam",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glendix-labs/MendixWidgetGleam.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/glendix-labs/MendixWidgetGleam/issues"
  },
  "homepage": "https://github.com/glendix-labs/MendixWidgetGleam/tree/main/cli#readme",
  "bin": "bin/create-mendix-widget-gleam.mjs",
  "files": [
    "bin/",
    "src/",
    "template/",
    "tui/build/dev/javascript/**/*.mjs",
    "README.md"
  ],
  "scripts": {
    "build:tui": "cd tui && gleam build --target javascript",
