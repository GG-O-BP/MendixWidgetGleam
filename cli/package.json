    "test:e2e": "bun test/template.e2e.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "mendix",
    "gleam",
    "widget",
    "pluggable-widget",
    "scaffold",
    "create"
